import { McTheme, McButton, McIconButton } from "../theme.slint";

export component AuthDialog inherits Rectangle {
    in property <bool> is-open: false;
    in property <string> user-code: "";
    in property <string> direct-verification-uri: "https://microsoft.com/link";
    in property <string> status-text: "Waiting for browser confirmation...";
    in property <bool> code-copied: false;
    in property <bool> url-copied: false;

    callback copy-code-clicked();
    callback copy-url-clicked();
    callback open-browser-clicked();
    callback close-clicked();

    visible: root.is-open;
    background: #000000cc;

    TouchArea {
        clicked => { root.close-clicked(); }
    }

    Rectangle {
        width: 500px;
        height: 350px;
        background: McTheme.panel-bg;
        border-color: McTheme.panel-border;
        border-width: 2px;

        TouchArea {}

        VerticalLayout {
            padding: 18px;
            spacing: 12px;
            alignment: space-between;

            HorizontalLayout {
                alignment: space-between;
                VerticalLayout {
                    alignment: center;
                    Text {
                        text: "MICROSOFT ACCOUNT SIGN IN";
                        font-size: 14px;
                        font-weight: 700;
                        color: #ffd54f;
                    }
                }
                McIconButton {
                    text: "X";
                    clicked => { root.close-clicked(); }
                }
            }

            Text {
                text: "LoxyLauncher uses official Microsoft Device Code authentication. Enter the code below at microsoft.com/link in your browser:";
                font-size: 12px;
                color: #d0d0d0;
                wrap: word-wrap;
            }

            Rectangle {
                height: 72px;
                background: McTheme.inset-bg;
                border-color: McTheme.inset-border;
                border-width: 1px;

                VerticalLayout {
                    padding: 8px;
                    alignment: center;
                    spacing: 4px;

                    Text {
                        text: "YOUR VERIFICATION CODE";
                        font-size: 10px;
                        font-weight: 700;
                        color: #aaaaaa;
                        horizontal-alignment: center;
                    }

                    Text {
                        text: root.user-code != "" ? root.user-code : "REQUESTING CODE...";
                        font-size: 22px;
                        font-weight: 700;
                        color: #66bb6a;
                        horizontal-alignment: center;
                    }
                }
            }

            // URL Row with Copy URL button
            Rectangle {
                height: 34px;
                background: #141414;
                border-color: #2a2a2a;
                border-width: 1px;

                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 6px;
                    spacing: 8px;

                    VerticalLayout {
                        alignment: center;
                        horizontal-stretch: 1;
                        Text {
                            text: root.direct-verification-uri;
                            font-size: 11px;
                            color: #80cbc4;
                            overflow: elide;
                        }
                    }

                    VerticalLayout {
                        alignment: center;
                        McButton {
                            text: root.url-copied ? "✓ COPIED" : "COPY LINK";
                            font-size: 10px;
                            h-padding: 8px;
                            v-padding: 4px;
                            clicked => { root.copy-url-clicked(); }
                        }
                    }
                }
            }

            Text {
                text: root.status-text;
                font-size: 11px;
                color: #81c784;
                horizontal-alignment: center;
                overflow: elide;
            }

            HorizontalLayout {
                spacing: 8px;
                alignment: space-between;

                McButton {
                    horizontal-stretch: 1;
                    text: root.code-copied ? "COPIED CODE! OPENING BROWSER..." : "COPY CODE & OPEN BROWSER";
                    gold: true;
                    disabled: root.user-code == "";
                    clicked => {
                        root.copy-code-clicked();
                        root.open-browser-clicked();
                    }
                }

                McButton {
                    text: "CLOSE";
                    clicked => { root.close-clicked(); }
                }
            }
        }
    }
}
