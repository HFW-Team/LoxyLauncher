import { McTheme, McButton, McIconButton } from "../theme.slint";
import { ModHitData, InstalledModData } from "../models.slint";
import { ListView } from "std-widgets.slint";

export component ModsDialog inherits Rectangle {
    in property <bool> is-open: false;
    in-out property <int> active-tab: 0; // 0 = browse, 1 = installed
    
    // Search properties
    in-out property <string> search-query: "";
    in property <[ModHitData]> search-results: [];
    in property <bool> is-searching: false;
    
    // Installed properties
    in property <[InstalledModData]> installed-mods: [];
    
    callback search-triggered(string);
    callback install-mod-clicked(string); // project_id
    callback toggle-mod-clicked(string); // filename
    callback delete-mod-clicked(string); // filename
    callback close-clicked();
    
    visible: root.is-open;
    background: #000000bb;
    TouchArea {}
    
    Rectangle {
        width: 780px;
        height: 560px;
        background: McTheme.panel-bg;
        border-color: McTheme.panel-border-highlight;
        border-width: 1px;
        
        VerticalLayout {
            padding: 18px;
            spacing: 12px;
            
            HorizontalLayout {
                alignment: space-between;
                
                HorizontalLayout {
                    spacing: 12px;
                    alignment: start;
                    Text {
                        text: "MOD MANAGER";
                        font-size: 15px;
                        font-weight: 700;
                        color: McTheme.text-primary;
                        vertical-alignment: center;
                    }
                    
                    HorizontalLayout {
                        spacing: 6px;
                        McButton {
                            text: "BROWSE MODRINTH";
                            primary: root.active-tab == 0;
                            font-size: 11px;
                            clicked => { root.active-tab = 0; }
                        }
                        McButton {
                            text: "INSTALLED MODS (" + root.installed-mods.length + ")";
                            primary: root.active-tab == 1;
                            font-size: 11px;
                            clicked => { root.active-tab = 1; }
                        }
                    }
                }
                
                McIconButton {
                    clicked => { root.close-clicked(); }
                }
            }
            
            // Tab 0: Browse Modrinth
            if root.active-tab == 0 : VerticalLayout {
                spacing: 10px;
                vertical-stretch: 1;
                
                // Search bar
                HorizontalLayout {
                    spacing: 8px;
                    Rectangle {
                        background: #141414;
                        border-color: #333333;
                        border-width: 1px;
                        height: 36px;
                        horizontal-stretch: 1;
                        
                        search-input := TextInput {
                            text <=> root.search-query;
                            color: McTheme.text-primary;
                            font-size: 12px;
                            vertical-alignment: center;
                            x: 10px;
                            width: parent.width - 20px;
                            accepted => { root.search-triggered(self.text); }
                        }
                    }
                    
                    McButton {
                        text: root.is-searching ? "SEARCHING..." : "SEARCH";
                        primary: true;
                        disabled: root.is-searching;
                        clicked => { root.search-triggered(root.search-query); }
                    }
                }
                
                // Mod Cards List
                Rectangle {
                    background: #0f0f0f;
                    border-color: #262626;
                    border-width: 1px;
                    vertical-stretch: 1;
                    
                    if root.search-results.length == 0 : Text {
                        text: root.is-searching ? "Searching Modrinth..." : "Type a mod name above and press Search";
                        color: #666666;
                        font-size: 12px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    
                    ListView {
                        for mod in root.search-results : Rectangle {
                            height: 72px;
                            
                            Rectangle {
                                y: parent.height - 1px;
                                height: 1px;
                                background: #222222;
                            }
                            
                            HorizontalLayout {
                                padding-left: 12px;
                                padding-right: 12px;
                                spacing: 12px;
                                alignment: space-between;
                                
                                VerticalLayout {
                                    alignment: center;
                                    spacing: 3px;
                                    horizontal-stretch: 1;
                                    
                                    HorizontalLayout {
                                        spacing: 8px;
                                        Text {
                                            text: mod.title;
                                            font-size: 13px;
                                            font-weight: 700;
                                            color: McTheme.text-primary;
                                        }
                                        Text {
                                            text: "by " + mod.author + " • " + (mod.downloads / 1000) + "k downloads";
                                            font-size: 10px;
                                            color: #888888;
                                            vertical-alignment: center;
                                        }
                                    }
                                    
                                    Text {
                                        text: mod.description;
                                        font-size: 11px;
                                        color: McTheme.text-secondary;
                                        overflow: elide;
                                    }
                                }
                                
                                McButton {
                                    text: mod.installed ? "INSTALLED" : "+ INSTALL";
                                    primary: !mod.installed;
                                    disabled: mod.installed;
                                    font-size: 10px;
                                    v-padding: 6px;
                                    h-padding: 10px;
                                    clicked => { root.install-mod-clicked(mod.project-id); }
                                }
                            }
                        }
                    }
                }
            }
            
            // Tab 1: Installed Mods
            if root.active-tab == 1 : VerticalLayout {
                spacing: 10px;
                vertical-stretch: 1;
                
                Rectangle {
                    background: #0f0f0f;
                    border-color: #262626;
                    border-width: 1px;
                    vertical-stretch: 1;
                    
                    if root.installed-mods.length == 0 : Text {
                        text: "No mods currently installed in instance mods/ folder";
                        color: #666666;
                        font-size: 12px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    
                    ListView {
                        for mod in root.installed-mods : Rectangle {
                            height: 48px;
                            
                            Rectangle {
                                y: parent.height - 1px;
                                height: 1px;
                                background: #222222;
                            }
                            
                            HorizontalLayout {
                                padding-left: 12px;
                                padding-right: 12px;
                                spacing: 12px;
                                alignment: space-between;
                                
                                HorizontalLayout {
                                    spacing: 8px;
                                    alignment: start;
                                    
                                    Text {
                                        text: mod.display-name;
                                        font-size: 12px;
                                        font-weight: 700;
                                        color: mod.is-disabled ? #666666 : McTheme.text-primary;
                                        vertical-alignment: center;
                                    }
                                    
                                    if mod.is-user-added : Rectangle {
                                        background: #1565c0;
                                        border-radius: 2px;
                                        height: 16px;
                                        width: 75px;
                                        y: (parent.height - self.height) / 2;
                                        Text {
                                            text: "USER ADDED";
                                            font-size: 8px;
                                            font-weight: 700;
                                            color: #ffffff;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }
                                    
                                    if !mod.is-user-added : Rectangle {
                                        background: #2e7d32;
                                        border-radius: 2px;
                                        height: 16px;
                                        width: 65px;
                                        y: (parent.height - self.height) / 2;
                                        Text {
                                            text: "MODPACK";
                                            font-size: 8px;
                                            font-weight: 700;
                                            color: #ffffff;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                                
                                HorizontalLayout {
                                    spacing: 6px;
                                    alignment: end;
                                    
                                    McButton {
                                        text: mod.is-disabled ? "ENABLE" : "DISABLE";
                                        font-size: 9px;
                                        v-padding: 4px;
                                        h-padding: 8px;
                                        clicked => { root.toggle-mod-clicked(mod.filename); }
                                    }
                                    
                                    McButton {
                                        text: "DELETE";
                                        danger: true;
                                        font-size: 9px;
                                        v-padding: 4px;
                                        h-padding: 8px;
                                        clicked => { root.delete-mod-clicked(mod.filename); }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
