import { McTheme, McButton, McIconButton } from "../theme.slint";
import { StoredAccountData } from "../models.slint";

export component AccountsDialog inherits Rectangle {
    in property <bool> is-open: false;
    in property <[StoredAccountData]> accounts: [];

    callback close-clicked();
    callback select-account-clicked(string); // uuid
    callback remove-account-clicked(string); // uuid
    callback add-account-clicked();
    callback open-skin-clicked();

    visible: root.is-open;
    background: #000000cc;

    TouchArea {
        clicked => { root.close-clicked(); }
    }

    Rectangle {
        width: 520px;
        height: 380px;
        background: McTheme.panel-bg;
        border-color: McTheme.panel-border;
        border-width: 2px;

        TouchArea {}

        VerticalLayout {
            padding: 16px;
            spacing: 12px;

            // Header
            HorizontalLayout {
                alignment: space-between;

                VerticalLayout {
                    alignment: center;
                    Text {
                        text: "SWITCH / MANAGE ACCOUNTS";
                        font-size: 14px;
                        font-weight: 700;
                        color: #66bb6a;
                    }
                }

                McIconButton {
                    text: "X";
                    clicked => { root.close-clicked(); }
                }
            }

            Rectangle {
                height: 2px;
                background: #181818;
            }

            // Scrollable Account List
            Rectangle {
                vertical-stretch: 1;
                background: McTheme.inset-bg;
                border-color: McTheme.inset-border;
                border-width: 1px;
                clip: true;

                VerticalLayout {
                    padding: 8px;
                    spacing: 6px;
                    alignment: start;

                    if root.accounts.length == 0 : Text {
                        height: 60px;
                        text: "No accounts saved yet. Click below to sign in.";
                        font-size: 12px;
                        color: #888888;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    for acc in root.accounts : Rectangle {
                        height: 52px;
                        background: acc.is-active ? #1b301c : #181818;
                        border-color: acc.is-active ? #4caf50 : #333333;
                        border-width: 1px;

                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            spacing: 10px;
                            alignment: space-between;

                            // Left: Avatar + Username
                            HorizontalLayout {
                                spacing: 10px;
                                alignment: start;

                                VerticalLayout {
                                    alignment: center;
                                    Rectangle {
                                        width: 32px;
                                        height: 32px;
                                        background: #2e7d32;
                                        border-color: #000000;
                                        border-width: 1px;
                                        clip: true;

                                        if acc.has-avatar : Image {
                                            width: 100%;
                                            height: 100%;
                                            source: acc.avatar;
                                            image-rendering: pixelated;
                                            image-fit: cover;
                                        }

                                        if !acc.has-avatar : Text {
                                            width: 100%;
                                            height: 100%;
                                            text: "MC";
                                            font-size: 10px;
                                            font-weight: 700;
                                            color: #ffffff;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }
                                }

                                VerticalLayout {
                                    alignment: center;
                                    spacing: 2px;

                                    HorizontalLayout {
                                        spacing: 6px;
                                        alignment: start;

                                        Text {
                                            text: acc.username;
                                            font-size: 13px;
                                            font-weight: 700;
                                            color: acc.is-active ? #a5d6a7 : #ffffff;
                                            overflow: elide;
                                        }

                                        if acc.is-active : Rectangle {
                                            width: 50px;
                                            height: 16px;
                                            background: #1b5e20;
                                            border-color: #388e3c;
                                            border-width: 1px;

                                            Text {
                                                width: 100%;
                                                height: 100%;
                                                text: "ACTIVE";
                                                font-size: 9px;
                                                font-weight: 700;
                                                color: #a5d6a7;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }

                                    Text {
                                        text: "Microsoft Account";
                                        font-size: 10px;
                                        color: #777777;
                                    }
                                }
                            }

                            // Right: Actions
                            VerticalLayout {
                                alignment: center;
                                HorizontalLayout {
                                    spacing: 6px;

                                    if acc.is-active : McButton {
                                        text: "SKIN & CAPE";
                                        font-size: 10px;
                                        h-padding: 8px;
                                        v-padding: 5px;
                                        clicked => { root.open-skin-clicked(); }
                                    }

                                    if !acc.is-active : McButton {
                                        text: "SELECT";
                                        primary: true;
                                        font-size: 10px;
                                        h-padding: 10px;
                                        v-padding: 5px;
                                        clicked => { root.select-account-clicked(acc.uuid); }
                                    }

                                    McButton {
                                        text: "REMOVE";
                                        danger: true;
                                        font-size: 10px;
                                        h-padding: 8px;
                                        v-padding: 5px;
                                        clicked => { root.remove-account-clicked(acc.uuid); }
                                    }
                                }
                            }
                        }
                    }
                }
            }

            // Bottom Buttons
            HorizontalLayout {
                spacing: 10px;
                alignment: space-between;

                McButton {
                    text: "+ ADD MICROSOFT ACCOUNT";
                    gold: true;
                    font-size: 11px;
                    h-padding: 14px;
                    v-padding: 7px;
                    clicked => { root.add-account-clicked(); }
                }

                McButton {
                    text: "DONE";
                    font-size: 11px;
                    h-padding: 16px;
                    v-padding: 7px;
                    clicked => { root.close-clicked(); }
                }
            }
        }
    }
}
