import { McTheme, McButton, McIconButton } from "../theme.slint";
import { LogEntryData } from "../models.slint";
import { ScrollView } from "std-widgets.slint";

export component ConsoleDialog inherits Rectangle {
    in property <bool> is-open: false;
    in property <[LogEntryData]> logs: [];
    in property <int> error-count: 0;
    in-out property <string> filter-level: "ALL";
    in property <bool> logs-copied: false;

    callback filter-selected(string);
    callback copy-logs-clicked();
    callback clear-logs-clicked();
    callback close-clicked();

    visible: root.is-open;
    background: #000000cc;

    TouchArea {
        clicked => { root.close-clicked(); }
    }

    Rectangle {
        width: 760px;
        height: 520px;
        background: McTheme.panel-bg;
        border-color: McTheme.panel-border;
        border-width: 2px;

        TouchArea {}

        VerticalLayout {
            padding: 18px;
            spacing: 12px;

            // Header
            HorizontalLayout {
                alignment: space-between;

                VerticalLayout {
                    alignment: center;
                    Text {
                        text: "REAL-TIME GAME LOG CONSOLE";
                        font-size: 14px;
                        font-weight: 700;
                        color: #4fc3f7;
                    }
                }

                HorizontalLayout {
                    spacing: 6px;
                    alignment: end;

                    VerticalLayout {
                        alignment: center;
                        McButton {
                            text: "ALL";
                            primary: root.filter-level == "ALL";
                            font-size: 10px;
                            h-padding: 10px;
                            v-padding: 5px;
                            clicked => {
                                root.filter-level = "ALL";
                                root.filter-selected("ALL");
                            }
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        McButton {
                            text: "INFO";
                            primary: root.filter-level == "INFO";
                            font-size: 10px;
                            h-padding: 10px;
                            v-padding: 5px;
                            clicked => {
                                root.filter-level = "INFO";
                                root.filter-selected("INFO");
                            }
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        McButton {
                            text: "WARN";
                            primary: root.filter-level == "WARN";
                            font-size: 10px;
                            h-padding: 10px;
                            v-padding: 5px;
                            clicked => {
                                root.filter-level = "WARN";
                                root.filter-selected("WARN");
                            }
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        McButton {
                            text: "ERROR (" + root.error-count + ")";
                            danger: root.filter-level == "ERROR" || root.error-count > 0;
                            font-size: 10px;
                            h-padding: 10px;
                            v-padding: 5px;
                            clicked => {
                                root.filter-level = "ERROR";
                                root.filter-selected("ERROR");
                            }
                        }
                    }

                    McIconButton {
                        text: "X";
                        clicked => { root.close-clicked(); }
                    }
                }
            }

            Rectangle {
                height: 2px;
                background: #181818;
            }

            // Log Output Box
            Rectangle {
                vertical-stretch: 1;
                background: McTheme.inset-bg;
                border-color: McTheme.inset-border;
                border-width: 1px;
                clip: true;

                if root.logs.length == 0 : Text {
                    width: 100%;
                    height: 100%;
                    text: "No game logs recorded yet. Launch the modpack to stream live JVM stdout/stderr.";
                    color: #777777;
                    font-size: 12px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                ScrollView {
                    width: 100%;
                    height: 100%;

                    VerticalLayout {
                        padding: 10px;
                        spacing: 4px;
                        alignment: start;

                        for entry in root.logs : HorizontalLayout {
                            spacing: 6px;
                            alignment: start;

                            Text {
                                text: "[" + entry.timestamp + "]";
                                font-size: 11px;
                                color: #777777;
                                width: 68px;
                            }

                            Text {
                                text: "[" + entry.level + "]";
                                font-size: 11px;
                                font-weight: 700;
                                width: 52px;
                                color: entry.level == "ERROR" ? #ff8a80 : (entry.level == "WARN" ? #ffd54f : #81c784);
                            }

                            Text {
                                horizontal-stretch: 1;
                                text: entry.line;
                                font-size: 11px;
                                color: entry.level == "ERROR" ? #ffcdd2 : (entry.level == "WARN" ? #ffe082 : #d0d0d0);
                                wrap: word-wrap;
                            }
                        }
                    }
                }
            }

            // Footer
            HorizontalLayout {
                alignment: space-between;

                HorizontalLayout {
                    spacing: 8px;
                    McButton {
                        text: root.logs-copied ? "COPIED TO CLIPBOARD!" : "COPY ALL LOGS";
                        font-size: 11px;
                        clicked => { root.copy-logs-clicked(); }
                    }
                    McButton {
                        text: "CLEAR";
                        danger: true;
                        font-size: 11px;
                        clicked => { root.clear-logs-clicked(); }
                    }
                }

                McButton {
                    text: "CLOSE";
                    font-size: 11px;
                    clicked => { root.close-clicked(); }
                }
            }
        }
    }
}
