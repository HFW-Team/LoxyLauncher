export struct ServerStatusData {
    online: bool,
    host: string,
    port: int,
    motd: string,
    players-online: int,
    players-max: int,
    latency-ms: int,
    has-latency: bool,
}

export struct AccountData {
    logged-in: bool,
    username: string,
    uuid: string,
    avatar: image,
    has-avatar: bool,
}

export struct ModpackData {
    name: string,
    version: string,
    mc-version: string,
    loader: string,
    loader-version: string,
    server-host: string,
    server-port: int,
    update-available: bool,
    is-offline-fallback: bool,
    is-mrpack: bool,
    news: string,
}

export struct ConfigData {
    instance-dir: string,
    shared-dir: string,
    min-ram-mb: int,
    max-ram-mb: int,
    recommended-ram-mb: int,
    total-system-ram-mb: int,
    jvm-args: string,
    java-path: string,
    resolution-width: string,
    resolution-height: string,
    fullscreen: bool,
    close-behavior: int, // 0 = HideAndReopen, 1 = KeepOpen, 2 = CloseLauncher
    discord-rpc: bool,
    keep-user-mods: bool,
    manifest-url: string,
    server-host: string,
    server-port: string,
}

export struct DetectedJavaData {
    path: string,
    major: int,
    version-string: string,
    label: string,
}

export struct ProgressData {
    active: bool,
    stage: string,
    current-file: string,
    completed: int,
    total: int,
    percent: int,
}

export struct LogEntryData {
    timestamp: string,
    level: string,
    line: string,
}

export struct StoredAccountData {
    uuid: string,
    username: string,
    is-active: bool,
    avatar: image,
    has-avatar: bool,
}

export struct ModHitData {
    project-id: string,
    project-type: string,
    slug: string,
    title: string,
    description: string,
    author: string,
    downloads: string,
    icon: image,
    has-icon: bool,
    installing: bool,
    versions-expanded: bool,
    is-installed: bool,
    installed-version: string,
    installed-filename: string,
}

export struct ModVersionData {
    id: string,
    project-id: string,
    name: string,
    version-number: string,
    game-versions: string,
    loaders: string,
    date-published: string,
    installing: bool,
    is-selected: bool,
}

export struct InstalledModData {
    filename: string,
    name: string,
    version: string,
    size-kb: int,
    enabled: bool,
    is-user-mod: bool,
    category: string,
    icon: image,
    has-icon: bool,
}

export struct CapeData {
    id: string,
    alias: string,
    is-active: bool,
    icon: image,
    has-icon: bool,
}

export struct SkinPresetData {
    id: string,
    name: string,
    variant: string,
    cape-id: string,
    cape-alias: string,
    date-str: string,
    skin-icon: image,
    has-skin-icon: bool,
    cape-icon: image,
    has-cape-icon: bool,
}
