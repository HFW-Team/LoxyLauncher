import { McTheme, McButton } from "theme.slint";
import {
    ServerStatusData, AccountData, ModpackData, ConfigData,
    DetectedJavaData, ProgressData, LogEntryData, ModHitData,
    ModVersionData, InstalledModData, StoredAccountData, CapeData,
    SkinPresetData
} from "models.slint";
import { AccountPill, ServerStatusPanel, ProfileTile } from "components/cards.slint";
import { AuthDialog } from "dialogs/auth.slint";
import { RamDialog } from "dialogs/ram.slint";
import { SettingsDialog } from "dialogs/settings.slint";
import { ModsDialog } from "dialogs/mods.slint";
import { ConsoleDialog } from "dialogs/console.slint";
import { AccountsDialog } from "dialogs/accounts.slint";
import { SkinDialog } from "dialogs/skin.slint";
import { ScrollView } from "std-widgets.slint";

export component MainWindow inherits Window {
    title: "LoxyLauncher";
    min-width: 940px;
    min-height: 620px;
    preferred-width: 1024px;
    preferred-height: 660px;
    background: McTheme.background;

    // Core State Properties
    in property <ServerStatusData> server-status: {
        online: false,
        host: "play.loxy.gg",
        port: 25565,
        motd: "Pinging server...",
        players-online: 0,
        players-max: 20,
        latency-ms: 0,
        has-latency: false,
    };

    in property <AccountData> account: {
        logged-in: false,
        username: "Player",
        uuid: "",
        has-avatar: false,
    };

    in property <ModpackData> modpack: {
        name: "Loxy Private Pack",
        version: "1.0.0",
        mc-version: "1.21.1",
        loader: "FABRIC",
        loader-version: "0.16.9",
        server-host: "play.loxy.gg",
        server-port: 25565,
        update-available: false,
        is-offline-fallback: false,
        is-mrpack: false,
        news: "Loading remote modpack manifest & server status...",
    };

    in-out property <ConfigData> config: {
        instance-dir: "~/.local/share/loxylauncher/instance",
        shared-dir: "~/.local/share/loxylauncher/shared",
        min-ram-mb: 2048,
        max-ram-mb: 4096,
        recommended-ram-mb: 6144,
        total-system-ram-mb: 16384,
        jvm-args: "-XX:+UseG1GC -XX:+ParallelRefProcEnabled -XX:MaxGCPauseMillis=200 -XX:+UnlockExperimentalVMOptions -XX:+DisableExplicitGC",
        java-path: "",
        resolution-width: "1280",
        resolution-height: "720",
        fullscreen: false,
        close-behavior: 0,
        discord-rpc: true,
        keep-user-mods: true,
        manifest-url: "https://raw.githubusercontent.com/loxy-community/modpack-manifest/main/launcher-manifest.json",
        server-host: "play.loxy.gg",
        server-port: "25565",
    };

    in property <[DetectedJavaData]> detected-javas: [];

    in property <ProgressData> progress: {
        active: false,
        stage: "Idle",
        current-file: "",
        completed: 0,
        total: 100,
        percent: 0,
    };

    in-out property <string> status-banner-text: "";
    in property <string> status-banner-type: "info"; // "info" | "warn" | "error"
    in property <bool> is-refreshing: false;
    in property <bool> is-launching: false;

    // Dialog Open States
    in-out property <bool> auth-open: false;
    in-out property <bool> ram-open: false;
    in-out property <bool> settings-open: false;
    in-out property <bool> mods-open: false;
    in-out property <bool> console-open: false;
    in-out property <bool> accounts-open: false;
    in-out property <bool> skin-open: false;

    // Skin Dialog Properties
    in property <image> skin-preview-image;
    in property <string> skin-active-variant: "CLASSIC";
    in-out property <string> skin-staged-variant: "CLASSIC";
    in property <string> skin-selected-path: "";
    in property <[CapeData]> skin-capes: [];
    in property <string> skin-active-cape-id: "";
    in-out property <string> skin-staged-cape-id: "";
    in property <[SkinPresetData]> skin-presets: [];
    in property <string> skin-status: "";
    in property <bool> skin-is-saving: false;

    // Accounts Dialog Properties
    in property <[StoredAccountData]> all-accounts: [];

    // Auth Dialog Properties
    in property <string> auth-user-code: "";
    in property <string> auth-verification-uri: "https://microsoft.com/link";
    in property <string> auth-status: "";
    in property <bool> auth-code-copied: false;
    in property <bool> auth-url-copied: false;

    // Console Dialog Properties
    in property <[LogEntryData]> console-logs: [];
    in property <int> console-error-count: 0;
    in-out property <string> console-filter: "ALL";
    in property <bool> console-logs-copied: false;

    // Mods Dialog Properties
    in-out property <string> mod-notice-text: "";
    in-out property <string> mod-search-query: "";
    in-out property <string> mod-filter-project-type: "mod";
    in-out property <string> mod-filter-mc-version: "1.21.1";
    in-out property <string> mod-filter-loader: "fabric";
    in-out property <string> mod-filter-sort: "relevance";
    in property <[ModHitData]> mod-search-results: [];
    in property <bool> mod-is-searching: false;

    in property <string> mod-expanded-project-id: "";
    in property <bool> mod-loading-versions: false;
    in property <[ModVersionData]> mod-expanded-versions: [];

    in-out property <string> mod-installed-filter: "";
    in-out property <string> mod-installed-category: "all";
    in property <[InstalledModData]> user-mods: [];
    in property <[InstalledModData]> pack-mods: [];

    // Callbacks to Rust Backend
    callback play-clicked();
    callback refresh-clicked();
    callback ping-only-clicked();
    callback copy-server-address-clicked();
    callback open-instance-folder-clicked();
    callback open-mods-modal-clicked();

    callback login-clicked();
    callback logout-clicked();
    callback select-account-clicked(string);
    callback remove-account-clicked(string);
    callback copy-auth-code-clicked();
    callback copy-auth-url-clicked();
    callback open-auth-browser-clicked();

    callback save-ram-clicked(int);
    callback save-settings-clicked();
    callback browse-instance-clicked();
    callback browse-java-clicked();

    callback console-filter-selected(string);
    callback copy-console-logs-clicked();
    callback clear-console-logs-clicked();

    callback toggle-keep-user-mods-clicked();
    callback mod-search-edited(string);
    callback mod-search-triggered(string);
    callback mod-project-type-selected(string);
    callback mod-mc-version-edited(string);
    callback mod-toggle-mc-version-all();
    callback mod-loader-selected(string);
    callback mod-sort-selected(string);
    callback mod-toggle-versions-clicked(string);
    callback mod-install-clicked(string, string);
    callback mod-installed-filter-edited(string);
    callback mod-installed-category-selected(string);
    callback mod-toggle-clicked(string);
    callback mod-delete-clicked(string);

    callback open-skin-dialog-clicked();
    callback skin-rotate(length, length);
    callback skin-reset-view();
    callback skin-select-file();
    callback skin-set-variant(string);
    callback skin-select-cape(string);
    callback skin-save-to-mojang();
    callback skin-reset();
    callback skin-save-preset(string);
    callback skin-load-preset(string);
    callback skin-delete-preset(string);

    // Main Root Layout
    VerticalLayout {
        // =============================================================
        // 1. TOP HEADER BAR
        // =============================================================
        Rectangle {
            height: 58px;
            background: McTheme.header-bg;
            border-color: #0d0d0d;
            border-width: 1px;

            HorizontalLayout {
                padding-left: 18px;
                padding-right: 18px;
                alignment: space-between;

                // Left Brand Logo + Title
                HorizontalLayout {
                    spacing: 12px;
                    alignment: start;

                    // Minecraft Grass Block Icon
                    VerticalLayout {
                        alignment: center;
                        Rectangle {
                            width: 34px;
                            height: 34px;
                            background: #5d4037;
                            border-color: #000000;
                            border-width: 2px;

                            // Green grass top layer
                            Rectangle {
                                x: 2px;
                                y: 2px;
                                width: parent.width - 4px;
                                height: 11px;
                                background: #43a047;
                            }
                        }
                    }

                    VerticalLayout {
                        alignment: center;
                        spacing: 2px;

                        Text {
                            text: "LOXY LAUNCHER";
                            font-size: 16px;
                            font-weight: 700;
                            color: #ffffff;
                            letter-spacing: 0.8px;
                        }

                        Text {
                            text: "v0.1.0 NATIVE • DEDICATED CLIENT";
                            font-size: 10px;
                            color: #81c784;
                        }
                    }
                }

                // Right Navigation Buttons + Account Pill (Reordered: Console -> Mods -> Settings -> Profile)
                HorizontalLayout {
                    spacing: 8px;
                    alignment: end;

                    // 1. CONSOLE
                    VerticalLayout {
                        alignment: center;
                        McButton {
                            text: root.console-error-count > 0 ? ("CONSOLE (" + root.console-error-count + ")") : "CONSOLE";
                            danger: root.console-error-count > 0;
                            font-size: 11px;
                            h-padding: 12px;
                            v-padding: 7px;
                            clicked => { root.console-open = true; }
                        }
                    }

                    // 2. MODS
                    VerticalLayout {
                        alignment: center;
                        McButton {
                            text: "MODS";
                            font-size: 11px;
                            h-padding: 12px;
                            v-padding: 7px;
                            clicked => { root.open-mods-modal-clicked(); }
                        }
                    }

                    // 3. SKIN & CAPE
                    if root.account.logged-in : VerticalLayout {
                        alignment: center;
                        McButton {
                            text: "SKIN";
                            font-size: 11px;
                            h-padding: 10px;
                            v-padding: 7px;
                            clicked => { root.open-skin-dialog-clicked(); }
                        }
                    }

                    // 4. SETTINGS (⚙ Cogwheel icon)
                    VerticalLayout {
                        alignment: center;
                        McButton {
                            text: "⚙";
                            font-size: 14px;
                            h-padding: 10px;
                            v-padding: 5px;
                            clicked => { root.settings-open = true; }
                        }
                    }

                    // 4. PROFILE
                    VerticalLayout {
                        alignment: center;
                        AccountPill {
                            account: root.account;
                            login-clicked => { root.login-clicked(); }
                            logout-clicked => { root.logout-clicked(); }
                            switch-clicked => { root.accounts-open = true; }
                        }
                    }
                }
            }
        }

        // =============================================================
        // 2. OPTIONAL STATUS BANNER
        // =============================================================
        if root.status-banner-text != "" : Rectangle {
            height: 30px;
            background: root.status-banner-type == "error" ? #7f1d1d :
                        (root.status-banner-type == "warn" ? #78350f : #14532d);
            border-color: #000000;
            border-width: 1px;

            HorizontalLayout {
                padding-left: 16px;
                padding-right: 16px;
                alignment: space-between;

                VerticalLayout {
                    alignment: center;
                    Text {
                        text: "[" + (root.status-banner-type == "error" ? "ERROR" : (root.status-banner-type == "warn" ? "WARN" : "INFO")) + "] " + root.status-banner-text;
                        font-size: 11px;
                        font-weight: 700;
                        color: root.status-banner-type == "error" ? #fecaca :
                               (root.status-banner-type == "warn" ? #fde68a : #bbf7d0);
                        overflow: elide;
                    }
                }

                VerticalLayout {
                    alignment: center;
                    McButton {
                        text: "DISMISS";
                        font-size: 9px;
                        h-padding: 8px;
                        v-padding: 3px;
                        clicked => { root.status-banner-text = ""; }
                    }
                }
            }
        }

        // =============================================================
        // 3. MAIN 2-COLUMN DASHBOARD AREA
        // =============================================================
        HorizontalLayout {
            vertical-stretch: 1;
            padding: 18px;
            spacing: 16px;

            // LEFT COLUMN (7/12 weight): Active Pack Banner + Server News & Notes
            VerticalLayout {
                horizontal-stretch: 7;
                spacing: 14px;

                // Active Modpack Banner Panel
                Rectangle {
                    height: 82px;
                    background: McTheme.panel-bg;
                    border-color: McTheme.panel-border;
                    border-width: 2px;

                    HorizontalLayout {
                        padding: 14px;
                        spacing: 12px;
                        alignment: space-between;

                        VerticalLayout {
                            alignment: center;
                            spacing: 4px;
                            horizontal-stretch: 1;
                            min-width: 0px;

                            Text {
                                text: root.modpack.name;
                                font-size: 18px;
                                font-weight: 700;
                                color: #ffffff;
                                overflow: elide;
                            }

                            Text {
                                text: "MC " + root.modpack.mc-version + " • " + root.modpack.loader + " " + root.modpack.loader-version + " • v" + root.modpack.version;
                                font-size: 11px;
                                font-weight: 700;
                                color: #81c784;
                                overflow: elide;
                            }
                        }

                        HorizontalLayout {
                            spacing: 8px;
                            alignment: end;

                            VerticalLayout {
                                alignment: center;
                                McButton {
                                    width: 78px;
                                    text: root.is-refreshing ? "..." : "REFRESH";
                                    disabled: root.is-refreshing;
                                    font-size: 11px;
                                    h-padding: 8px;
                                    v-padding: 5px;
                                    clicked => { root.refresh-clicked(); }
                                }
                            }

                            VerticalLayout {
                                alignment: center;
                                Rectangle {
                                    height: 26px;
                                    width: 128px;
                                    background: McTheme.inset-bg;
                                    border-color: McTheme.inset-border;
                                    border-width: 1px;

                                    Text {
                                        width: 100%;
                                        height: 100%;
                                        text: root.modpack.is-offline-fallback ? "OFFLINE CACHE" :
                                              (root.modpack.update-available ? "UPDATE READY" : "VERIFIED & READY");
                                        font-size: 10px;
                                        font-weight: 700;
                                        color: root.modpack.is-offline-fallback ? #ffb74d :
                                               (root.modpack.update-available ? #66bb6a : #a5d6a7);
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }
                    }
                }

                // Server News & Modpack Notes Panel
                Rectangle {
                    vertical-stretch: 1;
                    background: McTheme.panel-bg;
                    border-color: McTheme.panel-border;
                    border-width: 2px;

                    VerticalLayout {
                        padding: 14px;
                        spacing: 8px;

                        HorizontalLayout {
                            alignment: space-between;
                            Text {
                                text: "SERVER NEWS & MODPACK NOTES";
                                font-size: 11px;
                                font-weight: 700;
                                color: #b0bec5;
                            }
                            Text {
                                text: root.config.keep-user-mods ? "User Mods Allowed" : "Strict Pack Sync";
                                font-size: 11px;
                                color: #888888;
                            }
                        }

                        Rectangle {
                            height: 2px;
                            background: #1b1b1b;
                        }

                        Rectangle {
                            vertical-stretch: 1;
                            background: McTheme.inset-bg;
                            border-color: McTheme.inset-border;
                            border-width: 1px;
                            clip: true;

                            VerticalLayout {
                                padding: 12px;
                                spacing: 10px;
                                alignment: space-between;

                                ScrollView {
                                    vertical-stretch: 1;
                                    VerticalLayout {
                                        alignment: start;
                                        Text {
                                            text: root.modpack.news;
                                            font-size: 12px;
                                            color: #dedede;
                                            wrap: word-wrap;
                                        }
                                    }
                                }

                                VerticalLayout {
                                    spacing: 4px;

                                    Rectangle {
                                        height: 1px;
                                        background: #262626;
                                    }

                                    Text {
                                        text: "Remote Source: " + (root.modpack.is-mrpack ? "Modrinth .mrpack + Parallel SHA Verification" : "Remote JSON Hash Manifest");
                                        font-size: 11px;
                                        color: #999999;
                                        overflow: elide;
                                    }

                                    Text {
                                        text: "Instance Path: " + root.config.instance-dir;
                                        font-size: 11px;
                                        color: #999999;
                                        overflow: elide;
                                    }
                                }
                            }
                        }
                    }
                }
            }

            // RIGHT COLUMN (5/12 weight): Server Status + 2x2 Client Profile Grid
            VerticalLayout {
                horizontal-stretch: 5;
                spacing: 14px;

                ServerStatusPanel {
                    server: root.server-status;
                    is-refreshing: root.is-refreshing;
                    ping-clicked => { root.ping-only-clicked(); }
                    copy-address-clicked => { root.copy-server-address-clicked(); }
                }

                // Client Profile Configuration Card (2x2 Grid)
                Rectangle {
                    vertical-stretch: 1;
                    background: McTheme.panel-bg;
                    border-color: McTheme.panel-border;
                    border-width: 2px;

                    VerticalLayout {
                        padding: 14px;
                        spacing: 10px;
                        alignment: space-between;

                        VerticalLayout {
                            spacing: 6px;
                            Text {
                                text: "CLIENT PROFILE CONFIGURATION";
                                font-size: 11px;
                                font-weight: 700;
                                color: #b0bec5;
                            }
                            Rectangle {
                                height: 2px;
                                background: #1b1b1b;
                            }
                        }

                        GridLayout {
                            spacing: 8px;

                            // Row 1: Allocated RAM + Java Runtime
                            Row {
                                ProfileTile {
                                    label: "ALLOCATED RAM";
                                    action-hint: "EDIT";
                                    value: root.config.max-ram-mb + " MB";
                                    value-color: #66bb6a;
                                    hover-border-color: #66bb6a;
                                    clicked => { root.ram-open = true; }
                                }

                                ProfileTile {
                                    label: "JAVA RUNTIME";
                                    value: root.config.java-path != "" ? "Custom JDK" :
                                           (root.detected-javas.length > 0 ? ("System JDK (" + root.detected-javas.length + ")") : "Auto JRE");
                                    value-color: #4fc3f7;
                                    hover-border-color: #4fc3f7;
                                    clicked => { root.settings-open = true; }
                                }
                            }

                            // Row 2: Display + User Mods
                            Row {
                                ProfileTile {
                                    label: "DISPLAY";
                                    value: root.config.fullscreen ? "Fullscreen" : (root.config.resolution-width + "x" + root.config.resolution-height);
                                    value-color: #ffffff;
                                    hover-border-color: #ffffff;
                                    clicked => { root.settings-open = true; }
                                }

                                ProfileTile {
                                    label: "USER MODS";
                                    value: root.config.keep-user-mods ? "ALLOWED" : "LOCKED";
                                    value-color: #ce93d8;
                                    hover-border-color: #ce93d8;
                                    clicked => { root.open-mods-modal-clicked(); }
                                }
                            }
                        }
                    }
                }
            }
        }

        // =============================================================
        // 4. BOTTOM DIRT LAUNCH DECK (TRUE 3-COLUMN CENTERED PLAY BUTTON)
        // =============================================================
        Rectangle {
            height: 76px;
            background: McTheme.dirt-bg;
            border-color: #0d0d0d;
            border-width: 2px;

            HorizontalLayout {
                padding-left: 22px;
                padding-right: 22px;
                spacing: 16px;

                // Left Column: Sync Progress or Ready Indicator + Username
                Rectangle {
                    horizontal-stretch: 1;
                    min-width: 250px;

                    if root.progress.active : VerticalLayout {
                        alignment: center;
                        spacing: 4px;

                        HorizontalLayout {
                            alignment: space-between;
                            Text {
                                text: root.progress.stage;
                                font-size: 11px;
                                font-weight: 700;
                                color: #a5d6a7;
                                overflow: elide;
                            }
                            Text {
                                text: root.progress.percent + "%";
                                font-size: 11px;
                                font-weight: 700;
                                color: #ffffff;
                            }
                        }

                        Rectangle {
                            height: 12px;
                            background: McTheme.inset-bg;
                            border-color: McTheme.inset-border;
                            border-width: 1px;

                            Rectangle {
                                x: 1px;
                                y: 1px;
                                height: parent.height - 2px;
                                width: Math.min(1.0, Math.max(0.0, root.progress.percent / 100.0)) * (parent.width - 2px);
                                background: #43a047;
                            }
                        }

                        Text {
                            text: root.progress.current-file;
                            font-size: 10px;
                            color: #bdbdbd;
                            overflow: elide;
                        }
                    }

                    if !root.progress.active : HorizontalLayout {
                        spacing: 10px;
                        alignment: start;

                        VerticalLayout {
                            alignment: center;
                            Rectangle {
                                width: 12px;
                                height: 12px;
                                background: #66bb6a;
                                border-color: #000000;
                                border-width: 1px;
                            }
                        }

                        VerticalLayout {
                            alignment: center;
                            spacing: 3px;
                            min-width: 0px;

                            Text {
                                text: root.modpack.update-available ? ("Update v" + root.modpack.version + " Ready") : (root.modpack.name + " Ready");
                                font-size: 12px;
                                font-weight: 700;
                                color: #ffffff;
                                overflow: elide;
                            }

                            Text {
                                text: root.account.logged-in ? ("Signed in as " + root.account.username) : "Sign in with Microsoft to play";
                                font-size: 11px;
                                color: #c8e6c9;
                                overflow: elide;
                            }
                        }
                    }
                }

                // Center Column: Centered Play Button
                VerticalLayout {
                    alignment: center;
                    width: 250px;

                    McButton {
                        width: 240px;
                        height: 46px;
                        text: root.is-launching ? "LAUNCHING..." :
                              (!root.account.logged-in ? "SIGN IN & PLAY" :
                              (root.modpack.update-available ? "UPDATE & PLAY" : "► PLAY"));
                        primary: true;
                        disabled: root.is-launching;
                        font-size: 16px;
                        h-padding: 24px;
                        v-padding: 10px;
                        clicked => { root.play-clicked(); }
                    }
                }

                // Right Column: Quick Actions (Symmetric width to Left)
                Rectangle {
                    horizontal-stretch: 1;
                    min-width: 250px;

                    HorizontalLayout {
                        spacing: 8px;
                        alignment: end;

                        VerticalLayout {
                            alignment: center;
                            McButton {
                                text: "🧩 Add Content";
                                font-size: 11px;
                                h-padding: 12px;
                                v-padding: 7px;
                                clicked => { root.open-mods-modal-clicked(); }
                            }
                        }

                        VerticalLayout {
                            alignment: center;
                            McButton {
                                text: "INSTANCE FOLDER";
                                font-size: 11px;
                                h-padding: 12px;
                                v-padding: 7px;
                                clicked => { root.open-instance-folder-clicked(); }
                            }
                        }
                    }
                }
            }
        }
    }

    // =============================================================
    // 5. MODAL DIALOG OVERLAYS
    // =============================================================
    AccountsDialog {
        is-open <=> root.accounts-open;
        accounts: root.all-accounts;
        select-account-clicked(uuid) => { root.select-account-clicked(uuid); }
        remove-account-clicked(uuid) => { root.remove-account-clicked(uuid); }
        open-skin-clicked => {
            root.accounts-open = false;
            root.open-skin-dialog-clicked();
        }
        add-account-clicked => {
            root.accounts-open = false;
            root.login-clicked();
        }
        close-clicked => { root.accounts-open = false; }
    }

    AuthDialog {
        is-open <=> root.auth-open;
        user-code: root.auth-user-code;
        direct-verification-uri: root.auth-verification-uri;
        status-text: root.auth-status;
        code-copied: root.auth-code-copied;
        url-copied: root.auth-url-copied;
        copy-code-clicked => { root.copy-auth-code-clicked(); }
        copy-url-clicked => { root.copy-auth-url-clicked(); }
        open-browser-clicked => { root.open-auth-browser-clicked(); }
        close-clicked => { root.auth-open = false; }
    }

    RamDialog {
        is-open <=> root.ram-open;
        max-ram-mb <=> root.config.max-ram-mb;
        min-ram-mb <=> root.config.min-ram-mb;
        recommended-mb: root.config.recommended-ram-mb;
        system-total-mb: root.config.total-system-ram-mb;
        save-clicked => {
            root.ram-open = false;
            root.save-ram-clicked(root.config.max-ram-mb);
        }
        close-clicked => { root.ram-open = false; }
    }

    SettingsDialog {
        is-open <=> root.settings-open;
        config <=> root.config;
        detected-javas: root.detected-javas;
        browse-instance-clicked => { root.browse-instance-clicked(); }
        browse-java-clicked => { root.browse-java-clicked(); }
        save-clicked => {
            root.settings-open = false;
            root.save-settings-clicked();
        }
        close-clicked => { root.settings-open = false; }
    }

    ModsDialog {
        is-open <=> root.mods-open;
        keep-user-mods <=> root.config.keep-user-mods;
        notice-text <=> root.mod-notice-text;
        search-query <=> root.mod-search-query;
        filter-project-type <=> root.mod-filter-project-type;
        filter-mc-version <=> root.mod-filter-mc-version;
        filter-loader <=> root.mod-filter-loader;
        filter-sort <=> root.mod-filter-sort;
        search-results: root.mod-search-results;
        is-searching: root.mod-is-searching;
        expanded-project-id: root.mod-expanded-project-id;
        loading-versions: root.mod-loading-versions;
        expanded-project-versions: root.mod-expanded-versions;
        installed-filter <=> root.mod-installed-filter;
        installed-category <=> root.mod-installed-category;
        user-mods: root.user-mods;
        pack-mods: root.pack-mods;

        toggle-keep-user-mods => { root.toggle-keep-user-mods-clicked(); }
        search-edited(q) => { root.mod-search-edited(q); }
        search-triggered(q) => { root.mod-search-triggered(q); }
        project-type-selected(pt) => { root.mod-project-type-selected(pt); }
        mc-version-filter-edited(v) => { root.mod-mc-version-edited(v); }
        toggle-mc-version-all => { root.mod-toggle-mc-version-all(); }
        loader-filter-selected(l) => { root.mod-loader-selected(l); }
        sort-filter-selected(s) => { root.mod-sort-selected(s); }
        toggle-versions-clicked(id) => { root.mod-toggle-versions-clicked(id); }
        install-mod-clicked(pid, vid) => { root.mod-install-clicked(pid, vid); }
        installed-filter-edited(f) => { root.mod-installed-filter-edited(f); }
        installed-category-selected(cat) => { root.mod-installed-category-selected(cat); }
        toggle-mod-clicked(f) => { root.mod-toggle-clicked(f); }
        delete-mod-clicked(f) => { root.mod-delete-clicked(f); }
        close-clicked => { root.mods-open = false; }
    }

    ConsoleDialog {
        is-open <=> root.console-open;
        logs: root.console-logs;
        error-count: root.console-error-count;
        filter-level <=> root.console-filter;
        logs-copied: root.console-logs-copied;
        filter-selected(lvl) => { root.console-filter-selected(lvl); }
        copy-logs-clicked => { root.copy-console-logs-clicked(); }
        clear-logs-clicked => { root.clear-console-logs-clicked(); }
        close-clicked => { root.console-open = false; }
    }

    SkinDialog {
        is-open <=> root.skin-open;
        preview-image: root.skin-preview-image;
        username: root.account.username;
        active-variant: root.skin-active-variant;
        staged-variant <=> root.skin-staged-variant;
        selected-skin-path: root.skin-selected-path;
        capes: root.skin-capes;
        active-cape-id: root.skin-active-cape-id;
        staged-cape-id <=> root.skin-staged-cape-id;
        presets: root.skin-presets;
        status-text: root.skin-status;
        is-saving: root.skin-is-saving;
        close-clicked => { root.skin-open = false; }
        rotate-character(dx, dy) => { root.skin-rotate(dx, dy); }
        reset-view-clicked => { root.skin-reset-view(); }
        select-skin-file-clicked => { root.skin-select-file(); }
        set-variant-clicked(v) => { root.skin-set-variant(v); }
        select-cape-clicked(cid) => { root.skin-select-cape(cid); }
        save-to-mojang-clicked => { root.skin-save-to-mojang(); }
        reset-skin-clicked => { root.skin-reset(); }
        save-preset-clicked(name) => { root.skin-save-preset(name); }
        load-preset-clicked(id) => { root.skin-load-preset(id); }
        delete-preset-clicked(id) => { root.skin-delete-preset(id); }
    }
}
