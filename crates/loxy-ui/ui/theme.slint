export global McTheme {
    in property <color> background: #141414;
    in property <color> header-bg: #1c1c1c;
    in property <color> dirt-bg: #1a1612;
    in property <color> panel-bg: #242424;
    in property <color> panel-alt: #1b1b1b;
    in property <color> panel-border: #111111;
    in property <color> panel-bevel-light: #383838;
    in property <color> panel-bevel-dark: #161616;
    in property <color> inset-bg: #121212;
    in property <color> inset-border: #333333;

    in property <color> text-primary: #f2f2f2;
    in property <color> text-secondary: #bdbdbd;
    in property <color> text-muted: #888888;

    in property <color> green-normal: #2e7d32;
    in property <color> green-hover: #388e3c;
    in property <color> green-active: #1b5e20;
    in property <color> green-bevel: #66bb6a;

    in property <color> red-normal: #b71c1c;
    in property <color> red-hover: #c62828;
    in property <color> red-active: #7f0000;
    in property <color> red-bevel: #ef5350;

    in property <color> gold-normal: #f57f17;
    in property <color> gold-hover: #ff8f00;
    in property <color> gold-active: #e65100;
    in property <color> gold-bevel: #ffd54f;

    in property <color> btn-bg: #363636;
    in property <color> btn-hover: #464646;
    in property <color> btn-active: #262626;
    in property <color> btn-bevel: #555555;
}

export component McButton inherits Rectangle {
    in property <string> text: "BUTTON";
    in property <bool> primary: false;
    in property <bool> danger: false;
    in property <bool> gold: false;
    in property <bool> disabled: false;
    in property <length> font-size: 12px;
    in property <length> h-padding: 12px;
    in property <length> v-padding: 7px;

    callback clicked();

    vertical-stretch: 0;
    height: label.preferred-height + v-padding * 2;
    min-width: label.preferred-width + h-padding * 2;

    background: disabled ? #1e1e1e :
                primary ? (touch.pressed ? McTheme.green-active : (touch.has-hover ? McTheme.green-hover : McTheme.green-normal)) :
                danger ? (touch.pressed ? McTheme.red-active : (touch.has-hover ? McTheme.red-hover : McTheme.red-normal)) :
                gold ? (touch.pressed ? McTheme.gold-active : (touch.has-hover ? McTheme.gold-hover : McTheme.gold-normal)) :
                (touch.pressed ? McTheme.btn-active : (touch.has-hover ? McTheme.btn-hover : McTheme.btn-bg));

    border-color: #0d0d0d;
    border-width: 1px;

    // Top highlight bevel
    Rectangle {
        x: 1px;
        y: 1px;
        width: parent.width - 2px;
        height: 1px;
        background: root.disabled ? #282828 :
                    root.primary ? McTheme.green-bevel :
                    root.danger ? McTheme.red-bevel :
                    root.gold ? McTheme.gold-bevel :
                    McTheme.btn-bevel;
    }

    // Bottom shadow bevel
    Rectangle {
        x: 1px;
        y: parent.height - 2px;
        width: parent.width - 2px;
        height: 1px;
        background: #141414;
    }

    touch := TouchArea {
        enabled: !root.disabled;
        mouse-cursor: root.disabled ? default : pointer;
        clicked => { root.clicked(); }
    }

    label := Text {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        text: root.text;
        color: root.disabled ? #666666 : McTheme.text-primary;
        font-size: root.font-size;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

export component McIconButton inherits Rectangle {
    in property <string> text: "X";
    callback clicked();

    width: 28px;
    height: 28px;
    vertical-stretch: 0;
    background: touch.pressed ? #1e1e1e : (touch.has-hover ? #464646 : #323232);
    border-color: #111111;
    border-width: 1px;

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }

    Text {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        text: root.text;
        color: McTheme.text-primary;
        font-size: 12px;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

export component McTextInput inherits Rectangle {
    in-out property <string> text: "";
    in property <string> placeholder: "";
    in property <length> font-size: 12px;
    in property <length> box-height: 32px;

    callback edited(string);
    callback accepted(string);

    height: root.box-height;
    vertical-stretch: 0;
    background: #141414;
    border-color: input.has-focus ? #66bb6a : #3d3d3d;
    border-width: 1px;

    if root.text == "" && root.placeholder != "" : Text {
        x: 10px;
        y: 0px;
        width: parent.width - 20px;
        height: parent.height;
        text: root.placeholder;
        color: #666666;
        font-size: root.font-size;
        vertical-alignment: center;
        overflow: elide;
    }

    input := TextInput {
        x: 10px;
        y: 0px;
        width: parent.width - 20px;
        height: parent.height;
        text <=> root.text;
        color: #ffffff;
        font-size: root.font-size;
        vertical-alignment: center;
        single-line: true;
        edited => { root.edited(self.text); }
        accepted => { root.accepted(self.text); }
    }
}

export component McSlider inherits Rectangle {
    in-out property <int> value: 4096;
    in property <int> minimum: 2048;
    in property <int> maximum: 16384;
    in property <int> step: 512;
    in property <bool> enabled: true;

    callback changed(int);

    height: 28px;
    vertical-stretch: 0;

    property <length> thumb-width: 14px;
    property <length> track-width: Math.max(1px, root.width - root.thumb-width);
    property <float> progress: root.maximum > root.minimum ?
        Math.max(0.0, Math.min(1.0, (root.value - root.minimum) * 1.0 / Math.max(1, root.maximum - root.minimum))) : 0.0;

    function apply-x(mouse-x: length) {
        if (!root.enabled || root.maximum <= root.minimum) {
            return;
        }
        let track-w = root.width - root.thumb-width;
        if (track-w <= 0px) {
            return;
        }
        let rel-x = Math.max(0px, Math.min(track-w, mouse-x - root.thumb-width / 2));
        let fraction = rel-x / track-w;
        let range = (root.maximum - root.minimum) * 1.0;
        let raw-val = root.minimum + Math.round(fraction * range);
        let step-f = root.step * 1.0;
        let stepped = Math.round((raw-val - root.minimum) / step-f) * root.step + root.minimum;
        let clamped = Math.max(root.minimum, Math.min(root.maximum, stepped));
        root.value = clamped;
        root.changed(clamped);
    }

    // Inset Track
    Rectangle {
        x: 0px;
        y: (parent.height - 10px) / 2;
        width: parent.width;
        height: 10px;
        background: #0f0f0f;
        border-color: #333333;
        border-width: 1px;

        // Filled active track portion (green)
        Rectangle {
            x: 1px;
            y: 1px;
            height: parent.height - 2px;
            width: Math.max(0px, root.progress * (parent.width - 2px));
            background: #2e7d32;
        }
    }

    // Draggable Thumb Handle
    Rectangle {
        x: root.progress * root.track-width;
        y: (parent.height - 22px) / 2;
        width: root.thumb-width;
        height: 22px;
        background: touch.pressed ? #222222 : (touch.has-hover ? #555555 : #3d3d3d);
        border-color: #0d0d0d;
        border-width: 1px;

        // Top bevel highlight
        Rectangle {
            x: 1px;
            y: 1px;
            width: parent.width - 2px;
            height: 1px;
            background: touch.pressed ? #1a1a1a : #6e6e6e;
        }
        // Bottom bevel shadow
        Rectangle {
            x: 1px;
            y: parent.height - 2px;
            width: parent.width - 2px;
            height: 1px;
            background: #141414;
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down) {
                root.apply-x(self.mouse-x);
            }
        }
        moved => {
            if (self.pressed) {
                root.apply-x(self.mouse-x);
            }
        }
    }
}

